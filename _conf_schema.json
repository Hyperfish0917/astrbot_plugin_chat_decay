{
  "keywords": {
    "description": "触发词（命中任一即直接唤醒）",
    "type": "list",
    "hint": "包含匹配，不限消息开头；支持自定义多个关键词",
    "default": [
      "肥鱼",
      "鲸鱼",
      "deepseek"
    ]
  },
  "ignore_case": {
    "description": "关键词忽略英文大小写",
    "type": "bool",
    "default": true
  },
  "base_passive_rate": {
    "description": "冷启动主动插话概率（0～1）",
    "type": "float",
    "hint": "例如 0.2 为 20%",
    "default": 0.2
  },
  "decay_rate_1": {
    "description": "第 1 轮跟进概率（0～1）",
    "type": "float",
    "default": 1.0
  },
  "decay_rate_2": {
    "description": "第 2 轮跟进概率（0～1）",
    "type": "float",
    "default": 0.8
  },
  "decay_rate_3": {
    "description": "第 3 轮跟进概率（0～1）",
    "type": "float",
    "default": 0.5
  },
  "max_turns": {
    "description": "最大连续跟进轮数（1～3）",
    "type": "int",
    "hint": "3 轮全部成功后才进入强制冷却",
    "default": 3
  },
  "cooldown_seconds": {
    "description": "强制冷却时间（秒）",
    "type": "int",
    "hint": "在冷却期间，@、唤醒词等仍可唤醒并重置冷却",
    "default": 90
  },
  "session_timeout_seconds": {
    "description": "话题超时重置（秒）",
    "type": "int",
    "hint": "连续一段时间没有通过的消息后，概率重置到冷启动",
    "default": 30
  }
}
